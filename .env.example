# Copy to .env (gitignored) and fill in. Never commit .env.
# Mapillary — https://www.mapillary.com/dashboard/developers
MAPILLARY_APP_ID=
# Client token, format: MLY|<app_id>|<hash>  (used for Graph API + vector tiles)
MAPILLARY_ACCESS_TOKEN=""   # quote it: the token contains | characters
# Client secret is only needed for OAuth user flows; leave blank for read-only use.
MAPILLARY_CLIENT_SECRET=""

# OSM OAuth 2 app (public, PKCE) — https://www.openstreetmap.org/oauth2/applications
#   Confidential: unchecked · Redirect URI: urn:ietf:wg:oauth:2.0:oob · Scope: read_prefs
OSM_CLIENT_ID=""
# Written by scripts/kartaview_login.py
KARTAVIEW_ACCESS_TOKEN=""

# overpass.ch — key is part of the URL path: https://api.overpass.ch/v1/<key>/{interpreter,mcp}
OVERPASS_CH_API_KEY=""
