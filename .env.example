# Copy to .env (gitignored) and fill in. Never commit .env.
# Mapillary — https://www.mapillary.com/dashboard/developers
MAPILLARY_APP_ID=
# Client token, format: MLY|<app_id>|<hash>  (used for Graph API + vector tiles)
MAPILLARY_ACCESS_TOKEN=
# Client secret is only needed for OAuth user flows; leave blank for read-only use.
MAPILLARY_CLIENT_SECRET=
